{
  "name": "side-a",
  "private": true,
  "version": "0.1.0",
  "description": "Morning album picker for a Tidal collection: five albums, tap what fits your mood, narrow in, play.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "enrich": "tsx scripts/enrich.ts"
  },
  "devDependencies": {
    "@tidal-music/api": "0.53.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
