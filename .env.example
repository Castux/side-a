# Copy to .env.local and fill in. Never commit real values.

# Which library the app loads: "mock" (sample albums) or "tidal"
VITE_LIBRARY=mock

# Tidal developer app (https://developer.tidal.com). Register the redirect URI exactly.
VITE_TIDAL_CLIENT_ID=
VITE_TIDAL_REDIRECT_URI=http://localhost:5173/
VITE_TIDAL_COUNTRY=US

# Used only by `npm run enrich` (Node script, not the browser app)
TIDAL_ACCESS_TOKEN=
LASTFM_API_KEY=
# MusicBrainz requires an identifying User-Agent: app name, version, contact
MUSICBRAINZ_USER_AGENT=SideA/0.1 ( you@example.com )
# Folder of AcousticBrainz high-level JSON files named <recording-mbid>.json
ACOUSTICBRAINZ_DIR=data/acousticbrainz
